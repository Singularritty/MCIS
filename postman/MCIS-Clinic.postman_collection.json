						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"medicalRecordId\": \"{{medicalRecordId}}\",\n  \"patientId\": \"{{patientId}}\",\n  \"medicine\": \"Amoxicillin 500 mg\",\n  \"dosage\": \"3 x 1 tablet/hari\",\n  \"notes\": \"Diminum setelah makan\"\n}"
